# Copy to .env and fill in real values. Never commit .env itself.

# FRED (macro/rates/VIX) — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub (news/sentiment) — free key: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# SEC EDGAR — no key, but requires a descriptive User-Agent with a contact email per SEC policy
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# Tiingo (price cross-check) — free key: https://api.tiingo.com/account/api/token
TIINGO_API_KEY=your_tiingo_api_key_here

# Alpha Vantage (price fallback, ~25 req/day free) — free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Financial Modeling Prep (fundamentals alternative, ~250 req/day free) — free key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# Reddit (mention volume/sentiment) — free app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
